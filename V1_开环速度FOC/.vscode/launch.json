{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F407VGT6",
      "type": "cortex-debug",
      "request": "launch",

      "servertype": "openocd",

      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/gcc-debug/stm32f407vgt6_app.elf",

      "serverpath": "D:/Toolchain/OpenOCD-20260302-0.12.0/bin/openocd.exe",

      "configFiles": [
        "openocd/stm32f407.cfg"
      ],

      "device": "STM32F407VG",
      "interface": "swd",

      "armToolchainPath": "D:/Toolchain/arm-gnu-toolchain-13.3.Rel1/bin",
      "toolchainPrefix": "arm-none-eabi",
      "gdbPath": "D:/Toolchain/arm-gnu-toolchain-13.3.Rel1/bin/arm-none-eabi-gdb.exe",

      "debuggerArgs": [
        "--nx",
        "--nh"
      ],

      "runToEntryPoint": "main",

      "preLaunchTask": "Build STM32F407",

      "showDevDebugOutput": "raw"
    }
  ]
}
