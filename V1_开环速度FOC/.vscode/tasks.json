{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build STM32F407",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "gcc-debug-build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flash STM32F407",
      "type": "process",
      "command": "openocd",
      "args": [
        "-f",
        "openocd/stm32f407.cfg",
        "-c",
        "program build/gcc-debug/stm32f407vgt6_app.elf verify reset exit"
      ],
      "dependsOn": "Build STM32F407",
      "problemMatcher": []
    }
  ]
}
